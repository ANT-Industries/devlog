<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} | DevLog</title>
    <base href="{{base_href}}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <nav>
        <h1><a href="./">DevLog</a></h1>
        <ul>
            <li><a href="./">📜 Logs</a></li>
            <li><a href="hardware/">🖥️ Hardware</a></li>
            <li><a href="rss.xml">📡 RSS</a></li>
            <li><a href="https://github.com/ANT-Industries/devlog">💻 GitHub</a></li>
        </ul>
    </nav>
    <div class="container">
        <aside class="sidebar">
            <h3>Hardware Parts</h3>
            <ul>
                {{#hardware_items}}
                <li class="{{#active}}active{{/active}}">
                    <a href="hardware/{{slug}}/">
                        <span class="title">{{name}}</span>
                        <span class="date">{{category}}</span>
                    </a>
                </li>
                {{/hardware_items}}
            </ul>
        </aside>
        <main>
            <article>
                {{{content}}}
            </article>
        </main>
    </div>
</body>
</html>
